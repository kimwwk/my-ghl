# Copy to .env.local and fill in. Never commit real values.

# Bearer token for the agent REST API (/api/v1/*). Generate: openssl rand -hex 32
INVOICE_API_TOKEN=

# Public base URL of this app (used for the Google OAuth redirect URI)
APP_URL=http://localhost:8796

# Optional fallbacks; Settings values win when both are set
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to "file" to write .eml files to data/outbox/ instead of sending via Gmail
EMAIL_TRANSPORT=

# Docker server only: the address you open in the browser, e.g. the server's LAN IP. Caddy serves HTTPS on it.
SITE_ADDRESS=
